# PentasLirik Global Environment Variables
APP_NAME=PentasLirik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.01
DB_PORT=3306
DB_DATABASE=pentas_lirik
DB_USERNAME=sail
DB_PASSWORD=password

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Broadcast Driver & Reverb Configuration
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=pentaslirik
REVERB_APP_KEY=pentaslirik_key
REVERB_APP_SECRET=pentaslirik_secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost/api/v1
VITE_REVERB_APP_KEY=pentaslirik_key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
