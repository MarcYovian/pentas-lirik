{
  "name": "pentas-lirik",
  "private": true,
  "version": "1.3.0",
  "description": "Real-time Live Stage & OBS Overlay Lyric Projection System",
  "author": "MarcYovian <marcyovian@pentaslirik.local>",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcYovian/pentas-lirik.git"
  },
  "main": "dist/electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:docker": "vite --host 0.0.0.0 --port 80",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "desktop:build": "npm run build && esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/electron/preload.cjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "build:exe": "npm run desktop:build && electron-builder --win",
    "build:portable": "npm run desktop:build && electron-builder --win portable",
    "build:all": "npm run desktop:build && electron-builder --win --mac --linux",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
