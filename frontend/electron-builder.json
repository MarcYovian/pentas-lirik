{
  "appId": "com.pentaslirik.app",
  "productName": "PentasLirik",
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "MarcYovian",
    "repo": "pentas-lirik"
  },
  "files": [
    "dist/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon-512.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PentasLirik"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "public/icon-512.png",
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "maintainer": "MarcYovian <marcyovian@pentaslirik.local>",
    "icon": "public/icon-512.png",
    "category": "AudioVideo"
  }
}
